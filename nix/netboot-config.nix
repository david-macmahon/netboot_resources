# NixOS configuration for the cluster netboot image.
#
# The build is site-parameterized: with no `cluster` argument this is a
# GENERIC image (stateless, default ephemeral ssh host keys) -- the
# default-fallback node state. Cluster data (private repo) activates the
# identity features: the per-node persistent-storage mount, the ssh host
# key overlay, and admin ssh access.
#
# netboot-minimal.nix imports netboot-base.nix, which imports
# netboot.nix (the module providing system.build.netbootRamdisk /
# netbootIpxeScript / squashfsStore) plus the base and
# installation-device profiles.  The netboot module is NOT part of the
# default NixOS module list, so it must be imported explicitly.
#
# The stock udev module is replaced by a patched copy
# (./udev-nixos-patched.nix): the build host's kernel 4.4 cannot run
# the systemd 260 tools used by that module's builders (statx(2) is
# missing; see the copy's header comment for the full story).
#
# IDENTITY MODEL (two modes, selected by the kernel cmdline):
#   systemd.hostname=<name> present -> identity mode: the cmdline comes
#     from the node's registry-rendered iPXE script. systemd applies the
#     hostname in early boot, BEFORE unit loading -- which is what makes
#     the %H specifier below expand to the node's name.
#   absent                          -> generic mode: %H expands to the
#     fallback hostname ("nixos"), the per-node mount fails on a
#     nonexistent path (a cosmetic failed unit), and the node stays
#     stateless triage.
#
# PERSISTENT STORAGE: one static mount unit mounts the node's anchor
# (<persistentRoot>/%H) at /persistent. The unit file is shared by the
# whole fleet; %H is the only per-node part, expanded at unit-load time.
# The server exports the persistent ROOT as a whole tree (see the
# registry's exports artifact), so mounting a per-node subdirectory
# needs no server-side change and nothing is coupled to deploy ordering.
# The mount is ordered by systemd's automatic network dependencies for
# network filesystems (the same mechanism a fstab entry would get); sshd
# is NOT ordered after it.
#
# SSH HOST KEYS -- TWO KEYPAIRS, TWO MEANINGS:
#   baked key    generated once outside any build (~nix/keys/baked/),
#     embedded by the build at /etc/ssh/netboot_host_keys/ (mode 0600;
#     the bytes are public knowledge in this trust model -- the private
#     key lands in the world-readable nix store by design). Presented
#     from sshd's earliest start: sshd keeps STOCK ordering, so an
#     NFS-down boot still gives SSH. Clients pre-seeding this key know
#     that seeing it means "not fully booted or NFS-broken".
#   persistent key  generated by the registry's apply script into the
#     node's anchor (<persistentRoot>/by-mac/<mac>/etc/ssh/
#     netboot_host_keys/) when the anchor is materialized. After
#     /persistent mounts, the nixos-persistent-keys unit bind-mounts the
#     anchor's key directory over /etc/ssh/netboot_host_keys/ and reloads
#     sshd (SIGHUP re-exec re-reads host keys; existing sessions
#     survive). Generic-mode nodes never mount an anchor, so they present
#     the baked key forever -- which is exactly the "not fully
#     configured" signal.
#
# ANCHOR LAYOUT CONVENTION: the node's anchor shadows the rootfs layout
# where possible (<anchor>/etc/ssh/netboot_host_keys/ holds the ssh host
# keys, mirroring where they live on the node) -- sysadmins learn one
# layout, not two.
#   hostKeys is set ONLY in site builds (lib.mkIf): in generic builds
#   the openssh module default applies (rsa + ed25519 generated at boot).
{ cluster ? null }:

{ modulesPath, lib, pkgs, ... }:

let
  # Site features activate only when cluster data is provided.
  persistentDevice =
    if cluster == null then null
    else "${cluster.nfsServer}:${cluster.persistentRoot}";
  bakedHostKeys =
    if cluster == null then [ ]
    else cluster.nixos.bakedSshHostKeys or [ ];
  sshAuthorizedKeys =
    if cluster == null then [ ]
    else cluster.nixos.sshAuthorizedKeys or [ ];

  # Local directory the baked keys are embedded at (also the bind-mount
  # target of the overlay below). Mirrors the anchor-side path
  # <anchor>/etc/ssh/netboot_host_keys (the anchor shadows the rootfs
  # layout).
  bakedKeysDir = "/etc/ssh/netboot_host_keys";
in
{
  imports = [
    "${modulesPath}/installer/netboot/netboot-minimal.nix"
    ./udev-nixos-patched.nix
  ];

  disabledModules = [ "services/hardware/udev.nix" ];

  # NFS client support for the persistent-storage mount.
  boot.supportedFilesystems = [ "nfs" ];

  # One static mount unit for the whole fleet: the node's anchor path is
  # filled in by %H (hostname at unit-load time). The mount is TRIGGERED,
  # not boot-mounted: the automount unit below is what remote-fs.target
  # pulls in (instantly), and the real NFS mount starts when something
  # first touches /persistent. A node's first network can take ~30s to
  # carry traffic (e.g. switch spanning-tree delay before DHCP even
  # starts), so a boot-mounted NFS mount sat in the boot path behind
  # DHCP; with the automount the login prompt never waits for NFS, and
  # the key-overlay service (dispatched shortly after boot by the timer
  # below, and also pulled in by the mount itself) flips the ssh host
  # keys whenever the anchor actually appears. The
  # two-key design already defines "baked key = not fully booted", so a
  # longer baked-key window is the signal working, not a regression.
  # systemd adds the network-online ordering for network filesystems
  # automatically, same as a fstab entry would get.
  systemd.mounts = lib.mkIf (persistentDevice != null) [
    {
      what = "${persistentDevice}/%H";
      where = "/persistent";
      type = "nfs";
      options = "rw,noatime";
      # NOT wanted by remote-fs.target (that would mount it at boot);
      # the automount unit below is the boot-chain representative. When
      # the mount DOES complete, it pulls in the key-overlay service.
      wantedBy = [ ];
      wants = lib.mkIf (bakedHostKeys != [ ]) [ "nixos-persistent-keys.service" ];
    }
  ];

  systemd.automounts = lib.mkIf (persistentDevice != null) [
    {
      where = "/persistent";
      # No idle timeout: the mount must stay up (the key overlay
      # bind-mounts a subtree, which would pin the mount against an
      # unmount anyway, and remount churn under sshd is undesirable).
      # systemd's automount default is already "never idle-unmount".
      wantedBy = [ "remote-fs.target" ];
    }
  ];

  # Baked-in ssh host keys: copied from the stable external source into
  # the store by the build (stable across image rebuilds) and installed
  # at a fixed path, 0600.
  environment.etc = lib.mkIf (bakedHostKeys != [ ]) (
    builtins.listToAttrs (map (keyPath: {
      name = "ssh/netboot_host_keys/${baseNameOf keyPath}";
      value = {
        source = /. + keyPath;
        mode = "0600";
      };
    }) bakedHostKeys)
  );

  # The hostname comes from the kernel cmdline (systemd.hostname=,
  # rendered per node by the registry). The installer-profile default
  # static hostname ("nixos", written to /etc/hostname) gets re-applied
  # later (NetworkManager / hostnamed) and overrides it -- so write NO
  # static hostname: NixOS skips /etc/hostname entirely when hostName is
  # empty. (First-boot lesson: PID 1 set the cmdline hostname correctly
  # -- the NFS mount expanded %H right -- but the static hostname was
  # re-applied later (NetworkManager / hostnamed), so getty came up
  # under the default name.)
  networking.hostName = lib.mkForce "";

  # Persist the cmdline hostname to /etc/hostname BEFORE networking.
  # systemd applies systemd.hostname= at boot, but with no static
  # /etc/hostname NetworkManager invents "dhcp-<lease-ip>" for nodes
  # whose leases carry no hostname option -- and a netboot node can
  # lease on MORE than one subnet (a node's second NIC can find a
  # foreign DHCP server). Writing the file early pins the cmdline name
  # as the static one; NM then preserves it. Generic mode (no
  # systemd.hostname=)
  # writes nothing, leaving NM's dhcp-<ip> self-naming in place -- the
  # parked design for unregistered triage nodes.
  systemd.services.nixos-hostname = {
    description = "Persist the cmdline hostname to /etc/hostname";
    wantedBy = [ "sysinit.target" ];
    before = [ "network-pre.target" "shutdown.target" ];
    conflicts = [ "shutdown.target" ];
    unitConfig.DefaultDependencies = "no";
    serviceConfig.Type = "oneshot";
    serviceConfig.RemainAfterExit = true;
    script = ''
      host=""
      for p in $(cat /proc/cmdline); do
        case "$p" in
          systemd.hostname=*) host=''${p#systemd.hostname=} ;;
        esac
      done
      if [ -n "$host" ]; then
        echo "$host" > /etc/hostname
        echo "nixos-hostname: hostname=$host (from cmdline)"
      else
        echo "nixos-hostname: no systemd.hostname= on cmdline; generic mode"
      fi
    '';
  };

  # sshd serves the baked keys until the overlay swaps in the persistent
  # ones. mkIf (not an empty list) so generic builds keep the module
  # default keys (rsa + ed25519, generated at boot).
  services.openssh = {
    enable = true;
    settings.PermitRootLogin = "prohibit-password";
    hostKeys = lib.mkIf (bakedHostKeys != [ ]) (
      map (keyPath: {
        path = "${bakedKeysDir}/${baseNameOf keyPath}";
        type = "ed25519";
      }) bakedHostKeys
    );
  };

  # NetworkManager must never touch the hostname: leases on ANY interface
  # (a netboot node can see several subnets, and a foreign subnet's DHCP
  # server may supply its own lease name and domain) would otherwise
  # override the cmdline identity. hostnamed's static-hostname handling
  # also proved unreliable in the netboot image (hostnamectl showed the
  # static name as unset despite /etc/hostname), so NM is made hands-off
  # entirely: the cmdline owns the name (verified on the first boot).
  networking.networkmanager.settings.main.hostname-mode = "none";

  # Bound NetworkManager-wait-online: it waits for EVERY managed
  # interface to reach "connected" with no default limit, and a netboot
  # node can have several interfaces (a multi-homed node stretched it to
  # ~30s in the boot path -- the persistent NFS mount is ordered after
  # network-online.target). A bounded wait keeps the ordering benefit
  # without the tail latency.
  systemd.services.NetworkManager-wait-online.serviceConfig.TimeoutStartSec = "15s";

  # Admin access is key-only, via the cluster-declared public keys.
  users.users.root.openssh.authorizedKeys.keys = sshAuthorizedKeys;

  # ssh host key overlay: when /persistent actually mounts (the mount
  # unit pulls this service in via wants=), bind-mount the anchor's key
  # directory over the baked-key directory and reload sshd. The boot
  # chain never waits for this: remote-fs.target only carries the
  # automount, so the login prompt is up while this worker may still be
  # waiting for NFS. Everything that is a normal state rather than a
  # failure -- anchor without keys yet -- is a no-op with an
  # explanatory line, never a failed unit; a genuinely dead NFS server
  # ends the unit failed after bounded retries, with the baked key
  # remaining -- the "not fully booted" signal, by design. Guarded per
  # baked key file: reloading sshd with a HostKey path missing would
  # kill it on re-exec.
  systemd.services.nixos-persistent-keys =
    lib.mkIf (bakedHostKeys != [ ]) {
      description = "Overlay persistent ssh host keys over the baked-in ones";
      # NOT wanted by any boot target (a wanted unit's start job blocks
      # its target, and this job may wait minutes for NFS): dispatched
      # by the timer below. The timer firing is what makes the FIRST
      # access to /persistent and thus triggers the automount --
      # triggering the service only from the mount would be circular
      # (the mount starts only on first access). After sshd so the
      # reload below hits a running daemon; sshd starting later would
      # read the persistent keys itself, so either order is correct.
      wantedBy = [ ];
      after = [ "persistent.mount" "sshd.service" ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        # Each reachability check can block on the automount-triggered
        # mount job (up to the mount unit's start timeout), so the
        # default job timeout would kill the retry loop.
        TimeoutStartSec = "10min";
      };
      # mountpoint(1) and mount(8) come from util-linux, which is NOT in
      # the unit's default PATH -- without this the bind mount fails
      # with "command not found" (verified on the first boot).
      path = [ pkgs.util-linux ];
      script = let keydir = "/persistent/etc/ssh/netboot_host_keys"; in ''
        for attempt in 1 2 3; do
          if mountpoint -q ${bakedKeysDir}; then
            echo "nixos-persistent-keys: persistent keys already presented"
            exit 0
          fi
          # This stat is the automount trigger point: it starts the
          # real NFS mount and blocks until it succeeds or fails.
          if [ -d "${keydir}" ]; then
        '' + lib.concatMapStrings (keyPath:
          let name = baseNameOf keyPath; in ''
            if [ ! -s "${keydir}/${name}" ]; then
              echo "nixos-persistent-keys: ${keydir}/${name} missing; keeping baked key"
              exit 0
            fi
        '') bakedHostKeys + ''
            mkdir -p ${bakedKeysDir}
            mount --bind "${keydir}" ${bakedKeysDir}
            systemctl try-reload-or-restart sshd.service || true
            echo "nixos-persistent-keys: persistent host keys presented"
            exit 0
          fi
          echo "nixos-persistent-keys: /persistent not reachable yet (attempt $attempt/3); waiting"
          sleep 30
        done
        echo "nixos-persistent-keys: /persistent unreachable after retries; keeping baked key"
        exit 1
      '';
    };

  # The overlay worker's dispatch: fires once, 5s after boot. timers.
  # target sits in the boot chain but its jobs block nothing -- the
  # login prompt is unaffected no matter how long NFS takes. The
  # timer's start of the worker is the first access under the
  # automount, which starts the real NFS mount.
  systemd.timers.nixos-persistent-keys = lib.mkIf (bakedHostKeys != [ ]) {
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnBootSec = "5s";
      Unit = "nixos-persistent-keys.service";
    };
  };
}
