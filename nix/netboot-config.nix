# NixOS configuration for the cluster netboot image.
#
# The build is site-parameterized: with no `cluster` argument this is a
# GENERIC image (stateless, default ephemeral ssh host keys) -- the
# default-fallback node state. Cluster data (private repo) activates the
# identity features: the per-node persistent-storage mount, the ssh host
# key overlay, and admin ssh access.
#
# netboot-minimal.nix imports netboot-base.nix, which imports
# netboot.nix (the module providing system.build.netbootRamdisk /
# netbootIpxeScript / squashfsStore) plus the base and
# installation-device profiles.  The netboot module is NOT part of the
# default NixOS module list, so it must be imported explicitly.
#
# CLUSTER FEATURES: beyond identity, the config renders data-driven
# cluster features from the `cluster` argument (shared NFS mounts,
# per-label local-disk mounts, LDAP, admin users, time/syslog,
# mdadm/rdma, node exporter, and the netboot-persistent.target
# activation point) -- every feature is inert without cluster data.
#
# The stock udev module is replaced by a patched copy
# (./udev-nixos-patched.nix): the build host's kernel 4.4 cannot run
# the systemd 260 tools used by that module's builders (statx(2) is
# missing; see the copy's header comment for the full story).
#
# IDENTITY MODEL (two modes, selected by the kernel cmdline):
#   systemd.hostname=<name> present -> identity mode: the cmdline comes
#     from the node's registry-rendered iPXE script. systemd applies the
#     hostname in early boot, BEFORE unit loading -- which is what makes
#     the %H specifier below expand to the node's name.
#   absent                          -> generic mode: %H expands to the
#     fallback hostname ("nixos"), the per-node mount fails on a
#     nonexistent path (a cosmetic failed unit), and the node stays
#     stateless triage.
#
# PERSISTENT STORAGE: one static mount unit mounts the node's anchor
# (<persistentRoot>/%H) at /persistent. The unit file is shared by the
# whole fleet; %H is the only per-node part, expanded at unit-load time.
# The server exports the persistent ROOT as a whole tree (see the
# registry's exports artifact), so mounting a per-node subdirectory
# needs no server-side change and nothing is coupled to deploy ordering.
# The mount is ordered by systemd's automatic network dependencies for
# network filesystems (the same mechanism a fstab entry would get); sshd
# is NOT ordered after it.
#
# SSH HOST KEYS -- TWO KEYPAIRS, TWO MEANINGS:
#   baked key    generated once outside any build (~nix/keys/baked/),
#     embedded by the build at /etc/ssh/netboot_host_keys/ (mode 0600;
#     the bytes are public knowledge in this trust model -- the private
#     key lands in the world-readable nix store by design). Presented
#     from sshd's earliest start: sshd keeps STOCK ordering, so an
#     NFS-down boot still gives SSH. Clients pre-seeding this key know
#     that seeing it means "not fully booted or NFS-broken".
#   persistent key  generated by the registry's apply script into the
#     node's anchor (<persistentRoot>/by-mac/<mac>/etc/ssh/
#     netboot_host_keys/) when the anchor is materialized. After
#     /persistent mounts, the nixos-persistent-keys unit bind-mounts the
#     anchor's key directory over /etc/ssh/netboot_host_keys/ and reloads
#     sshd (SIGHUP re-exec re-reads host keys; existing sessions
#     survive). Generic-mode nodes never mount an anchor, so they present
#     the baked key forever -- which is exactly the "not fully
#     configured" signal.
#
# ANCHOR LAYOUT CONVENTION: the node's anchor shadows the rootfs layout
# where possible (<anchor>/etc/ssh/netboot_host_keys/ holds the ssh host
# keys, mirroring where they live on the node) -- sysadmins learn one
# layout, not two.
#   hostKeys is set ONLY in site builds (lib.mkIf): in generic builds
#   the openssh module default applies (rsa + ed25519 generated at boot).
{ cluster ? null, profileConfig ? null }:

{ modulesPath, lib, pkgs, ... }:

let
  # Site features activate only when cluster data is provided.
  persistentDevice =
    if cluster == null then null
    else "${cluster.nfsServer}:${cluster.persistentRoot}";
  bakedHostKeys =
    if cluster == null then [ ]
    else cluster.nixos.bakedSshHostKeys or [ ];
  sshAuthorizedKeys =
    if cluster == null then [ ]
    else cluster.nixos.sshAuthorizedKeys or [ ];

  # CLUSTER FEATURES (site data in the private repo's nodes/ch.nix).
  # Each is data-driven machinery: the public code renders whatever the
  # cluster declares, and every feature is inert (or absent) in generic
  # builds and when the cluster omits it. Nothing here is
  # site-specific; the SITE is in ch.nix.
  ldap = if cluster == null then null else cluster.ldap or null;
  adminUsers = if cluster == null then [ ] else cluster.adminUsers or [ ];
  # LDAP users (by uid name) that need sudo: rendered as members of
  # the local wheel group entry. A local group listing an LDAP name
  # works without a local user -- NSS resolves the member list by
  # name at initgroups/sudo time (the same mechanism the house's
  # rootfs /etc/group sudo entry used for LDAP members).
  sudoUsers = if cluster == null then [ ] else cluster.sudoUsers or [ ];
  # mountpoint -> server-side export path (under cluster.nfsServer)
  sharedMounts =
    if cluster == null then { } else cluster.sharedMounts or { };
  mountDirs = if cluster == null then [ ] else cluster.mountDirs or [ ];
  diskLabels = if cluster == null then [ ] else cluster.diskLabels or [ ];
  timeServers = if cluster == null then null else cluster.timeServers or null;
  timeZone = if cluster == null then null else cluster.timeZone or null;
  logServer = if cluster == null then null else cluster.logServer or null;
  useRdma = if cluster == null then false else cluster.rdma or false;
  useSwraid = if cluster == null then false else cluster.swraid or false;
  mdadmConf = if cluster == null then "" else cluster.nixos.mdadmConf or "";
  useNodeExporter =
    if cluster == null then false else cluster.nodeExporter or false;

  # Local directory the baked keys are embedded at (also the bind-mount
  # target of the overlay below). Mirrors the anchor-side path
  # <anchor>/etc/ssh/netboot_host_keys (the anchor shadows the rootfs
  # layout).
  bakedKeysDir = "/etc/ssh/netboot_host_keys";
in
{
  imports = [
    "${modulesPath}/installer/netboot/netboot-minimal.nix"
    ./udev-nixos-patched.nix
  ] ++ lib.optionals (profileConfig != null) [ profileConfig ];

  disabledModules = [ "services/hardware/udev.nix" ];

  # NFS client support for the persistent-storage mount.
  boot.supportedFilesystems = lib.mkMerge [
    { nfs = true; }
    (lib.mkIf (cluster != null) { zfs = lib.mkForce false; })
  ];

  # One static mount unit for the whole fleet: the node's anchor path is
  # filled in by %H (hostname at unit-load time). The mount is TRIGGERED,
  # not boot-mounted: the automount unit below is what remote-fs.target
  # pulls in (instantly), and the real NFS mount starts when something
  # first touches /persistent. A node's first network can take ~30s to
  # carry traffic (e.g. switch spanning-tree delay before DHCP even
  # starts), so a boot-mounted NFS mount sat in the boot path behind
  # DHCP; with the automount the login prompt never waits for NFS, and
  # the key-overlay service (dispatched shortly after boot by the timer
  # below, and also pulled in by the mount itself) flips the ssh host
  # keys whenever the anchor actually appears. The
  # two-key design already defines "baked key = not fully booted", so a
  # longer baked-key window is the signal working, not a regression.
  # The mount is explicitly ordered after network-online.target below --
  # despite the folklore, systemd does NOT add that ordering for
  # network filesystems on its own (the realized unit carried no such
  # dependency, which is how a mount attempt once fired into a dark
  # network and burned its whole start timeout).
  systemd.mounts = lib.mkMerge [
    (lib.mkIf (persistentDevice != null) [
      {
        what = "${persistentDevice}/%H";
        where = "/persistent";
        type = "nfs";
        options = "rw,noatime";
        # NOT wanted by remote-fs.target (that would mount it at boot);
        # the automount unit below is the boot-chain representative. Wait
        # for a genuinely usable network before the one real mount
        # attempt: pulled in and ordered after network-online.target (see
        # the wait-online note above). The trigger (the overlay worker's
        # stat) may fire long before that -- the MOUNT JOB waits, and
        # nothing in the boot chain waits for the mount. When the mount
        # DOES complete, it pulls in the key-overlay service.
        wantedBy = [ ];
        wants = [ "network-online.target" ]
          ++ lib.optionals (bakedHostKeys != [ ]) [ "nixos-persistent-keys.service" ];
        after = [ "network-online.target" ];
      }
    ])
    # SHARED NFS MOUNTS (cluster.sharedMounts: mountpoint -> server-side
    # path under cluster.nfsServer) -- triggered automounts like
    # /persistent: the boot chain never waits for NFS; the real mount
    # starts on first use and never idles out. hard + nofail: a dead
    # NFS server hangs accesses (the POSIX behavior users expect from
    # /home) without failing anything at boot. nfsvers=3 matches the
    # house exports (no NFSv4 on the server); nointr is obsolete on
    # modern kernels. The mount unit's start-rate limit is disabled:
    # an access fired during the boot's network-dark window fails
    # INSTANTLY (mount.nfs ENETUNREACH), and systemd's default 5-per-
    # 10s start limit then kills the automount permanently
    # (blh3's first healthy-network boot lost /home exactly this way
    # while /persistent, mounted a minute later, worked). With no
    # limit, every access retries until the network is real. The
    # automount is also ordered after network-online.target so it is
    # not even armed during early boot (best effort -- the target can
    # complete on a failed wait-online).
    (lib.mapAttrsToList (where: what: {
      what = "${cluster.nfsServer}:${what}";
      where = where;
      type = "nfs";
      options = "nfsvers=3,rw,noatime,hard,nofail";
      wantedBy = [ ];
      wants = [ "network-online.target" ];
      after = [ "network-online.target" ];
      # Disable the start-rate limit (see the note below the
      # automounts for why: failed attempts during the boot's
      # network-dark window must not permanently kill the mount).
      startLimitIntervalSec = 0;
      startLimitBurst = 0;
    }) sharedMounts)
    # LOCAL DISKS: generic per-label mount units (cluster.diskLabels),
    # shared by the whole fleet and activated PER NODE via the anchor's
    # netboot-persistent.target.wants (the house mountbylabel pattern:
    # a disk's filesystem label names its mountpoint). No boot wiring
    # (wantedBy=[]): a node without the disks simply never activates
    # them, and adding a disk to a node is anchor-side work only. Raid
    # assembly below makes the by-label links appear by multi-user.
    (map (label: {
      what = "/dev/disk/by-label/${label}";
      where = "/${label}";
      options = "noatime,nodiratime";
      wantedBy = [ ];
      mountConfig.TimeoutSec = "10s";
    }) diskLabels)
  ];

  systemd.automounts = lib.mkMerge [
    (lib.mkIf (persistentDevice != null) [
      {
        where = "/persistent";
        # No idle timeout: the mount must stay up (the key overlay
        # bind-mounts a subtree, which would pin the mount against an
        # unmount anyway, and remount churn under sshd is undesirable).
        # systemd's automount default is already "never idle-unmount".
        wantedBy = [ "remote-fs.target" ];
      }
    ])
    (lib.mapAttrsToList (where: _:
      {
        where = where;
        # No idle timeout: once a session has its home open, an unmount
        # (and the re-mount churn under it) is worse than staying up.
        # Ordered after network-online so the automount is not armed
        # during the network-dark boot window (best effort; the mount
        # unit's disabled start-rate limit is the real self-healing).
        wantedBy = [ "remote-fs.target" ];
        wants = [ "network-online.target" ];
        after = [ "network-online.target" ];
      }) sharedMounts)
  ];

  # Start-rate limit is disabled on the shared NFS mount units (see
  # the mount definitions above): an access fired during the boot's
  # network-dark window fails INSTANTLY (mount.nfs ENETUNREACH), and
  # systemd's default 5-per-10s start limit then kills the automount
  # permanently (blh3 lost /home exactly this way while /persistent,
  # mounted a minute later, worked). With no limit, every access
  # retries until the network is genuinely up.

  # Baked-in ssh host keys: copied from the stable external source into
  # the store by the build (stable across image rebuilds) and installed
  # at a fixed path, 0600. (One module, one assignment.)
  environment.etc = lib.mkMerge [
    (lib.mkIf (bakedHostKeys != [ ]) (
      builtins.listToAttrs (map (keyPath: {
        name = "ssh/netboot_host_keys/${baseNameOf keyPath}";
        value = {
          source = /. + keyPath;
          mode = "0600";
        };
      }) bakedHostKeys)
    ))
  ];

  # The hostname comes from the kernel cmdline (systemd.hostname=,
  # rendered per node by the registry). The installer-profile default
  # static hostname ("nixos", written to /etc/hostname) gets re-applied
  # later (NetworkManager / hostnamed) and overrides it -- so write NO
  # static hostname: NixOS skips /etc/hostname entirely when hostName is
  # empty. (First-boot lesson: PID 1 set the cmdline hostname correctly
  # -- the NFS mount expanded %H right -- but the static hostname was
  # re-applied later (NetworkManager / hostnamed), so getty came up
  # under the default name.)
  networking.hostName = lib.mkForce "";

  # Persist the cmdline hostname to /etc/hostname BEFORE networking.
  # systemd applies systemd.hostname= at boot, but with no static
  # /etc/hostname NetworkManager invents "dhcp-<lease-ip>" for nodes
  # whose leases carry no hostname option -- and a netboot node can
  # lease on MORE than one subnet (a node's second NIC can find a
  # foreign DHCP server). Writing the file early pins the cmdline name
  # as the static one; NM then preserves it. Generic mode (no
  # systemd.hostname=)
  # writes nothing, leaving NM's dhcp-<ip> self-naming in place -- the
  # parked design for unregistered triage nodes.
  systemd.services.nixos-hostname = {
    description = "Persist the cmdline hostname to /etc/hostname";
    wantedBy = [ "sysinit.target" ];
    before = [ "network-pre.target" "shutdown.target" ];
    conflicts = [ "shutdown.target" ];
    unitConfig.DefaultDependencies = "no";
    serviceConfig.Type = "oneshot";
    serviceConfig.RemainAfterExit = true;
    script = ''
      host=""
      for p in $(cat /proc/cmdline); do
        case "$p" in
          systemd.hostname=*) host=''${p#systemd.hostname=} ;;
        esac
      done
      if [ -n "$host" ]; then
        echo "$host" > /etc/hostname
        echo "nixos-hostname: hostname=$host (from cmdline)"
      else
        echo "nixos-hostname: no systemd.hostname= on cmdline; generic mode"
      fi
    '';
  };

  # sshd serves the baked keys until the overlay swaps in the persistent
  # ones. mkIf (not an empty list) so generic builds keep the module
  # default keys (rsa + ed25519, generated at boot).
  services.openssh = {
    enable = true;
    settings.PermitRootLogin = "prohibit-password";
    # ssh-keyscan probes every host-key algorithm in parallel; a node
    # serving only ed25519 answers ~4 of every 5 probe connections
    # with a failed negotiation, and OpenSSH's per-source penalties
    # (enabled by default in recent sshd) then start refusing the
    # probing address -- which masquerades as "node down" precisely
    # when admins are checking the not-fully-booted signal. Key-only
    # auth makes brute-force penalties redundant on these nodes; off.
    settings.PerSourcePenalties = "no";
    hostKeys = lib.mkIf (bakedHostKeys != [ ]) (
      map (keyPath: {
        path = "${bakedKeysDir}/${baseNameOf keyPath}";
        type = "ed25519";
      }) bakedHostKeys
    );
  };

  # NetworkManager must never touch the hostname: leases on ANY interface
  # (a netboot node can see several subnets, and a foreign subnet's DHCP
  # server may supply its own lease name and domain) would otherwise
  # override the cmdline identity. hostnamed's static-hostname handling
  # also proved unreliable in the netboot image (hostnamectl showed the
  # static name as unset despite /etc/hostname), so NM is made hands-off
  # entirely: the cmdline owns the name (verified on the first boot).
  networking.networkmanager.settings.main.hostname-mode = "none";

  # NetworkManager-wait-online with a generous bound. It waits for EVERY
  # managed interface to reach "connected", which on a multi-homed node
  # takes ~30s (foreign subnets, slow NICs). The boot itself never waits
  # for it -- /persistent is an automount, so nothing in the boot chain
  # consumes network-online.target -- but the persistent mount DOES: the
  # overlay worker triggers it at boot+5s, and the mount job waits for
  # network-online.target before mounting, so the one real mount attempt
  # happens into a ready network instead of burning its whole start
  # timeout against a dark one (that blind attempt is what made the
  # boot-to-key-flip take ~2 minutes). The bound only caps pathological
  # cases (an interface stuck acquiring DHCP forever); on healthy boots
  # wait-online completes naturally first.
  systemd.services.NetworkManager-wait-online.serviceConfig.TimeoutStartSec = "90s";

  # Admin access is key-only, via the cluster-declared public keys.
  # Merged with the cluster-features admin accounts further down
  # (one module, one assignment).
  users.users = lib.mkMerge [
    { root.openssh.authorizedKeys.keys = sshAuthorizedKeys; }
    # Local admin accounts (LDAP handles ordinary users). Homes live
    # on the shared /home mount -- createHome is false so the node
    # never mkdirs into NFS (the accounts are identity, not home
    # providers).
    (builtins.listToAttrs (map (u: {
      name = u.name;
      value = {
        uid = u.uid;
        isNormalUser = true;
        home = "/home/${u.name}";
        createHome = false;
        # Sudo via NixOS's native wheel group (the house's gid-27
        # "sudo" group is NOT carried forward: its only consumers were
        # the stock Ubuntu sudoers rule and one sudoers.d exception
        # whose binary lives in node-local /usr/local; wheel gives the
        # identical password-required UX).
        extraGroups = [ "wheel" ];
      };
    }) adminUsers))
    # The installer's default "nixos" account (empty password, wheel
    # membership) is an installer convenience, not a fleet identity:
    # lock it and strip it from wheel. Root's console password is
    # locked too (davidm: all fixes can be made on the head node --
    # the netboot model makes node-local rescue unnecessary; admin
    # access is ssh-key-only via the two-key overlay).
    (lib.mkIf (cluster != null) {
      nixos = {
        hashedPassword = lib.mkForce "!";
        initialHashedPassword = lib.mkForce "!";
        extraGroups = lib.mkForce [ ];
      };
      root = {
        hashedPassword = lib.mkForce "!";
        initialHashedPassword = lib.mkForce "!";
      };
    })
  ];

  # ssh host key overlay: when /persistent actually mounts (the mount
  # unit pulls this service in via wants=), bind-mount the anchor's key
  # directory over the baked-key directory and reload sshd. The boot
  # chain never waits for this: remote-fs.target only carries the
  # automount, so the login prompt is up while this worker may still be
  # waiting for NFS. Everything that is a normal state rather than a
  # failure -- anchor without keys yet -- is a no-op with an
  # explanatory line, never a failed unit; a genuinely dead NFS server
  # ends the unit failed after bounded retries, with the baked key
  # remaining -- the "not fully booted" signal, by design. Guarded per
  # baked key file: reloading sshd with a HostKey path missing would
  # kill it on re-exec.
  systemd.services.nixos-persistent-keys =
    lib.mkIf (bakedHostKeys != [ ]) {
      description = "Overlay persistent ssh host keys over the baked-in ones";
      # NOT wanted by any boot target (a wanted unit's start job blocks
      # its target, and this job may wait minutes for NFS): dispatched
      # by the timer below. The timer firing is what makes the FIRST
      # access to /persistent and thus triggers the automount --
      # triggering the service only from the mount would be circular
      # (the mount starts only on first access). After sshd so the
      # reload below hits a running daemon; sshd starting later would
      # read the persistent keys itself, so either order is correct.
      wantedBy = [ ];
      after = [ "persistent.mount" "sshd.service" ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        # Each reachability check can block on the automount-triggered
        # mount job (up to the mount unit's start timeout), so the
        # default job timeout would kill the retry loop.
        TimeoutStartSec = "10min";
      };
      # mountpoint(1) and mount(8) come from util-linux, which is NOT in
      # the unit's default PATH -- without this the bind mount fails
      # with "command not found" (verified on the first boot).
      path = [ pkgs.util-linux ];
      script = let keydir = "/persistent/etc/ssh/netboot_host_keys"; in ''
        for attempt in 1 2 3; do
          if mountpoint -q ${bakedKeysDir}; then
            echo "nixos-persistent-keys: persistent keys already presented"
            exit 0
          fi
          # This stat is the automount trigger point: it starts the
          # real NFS mount and blocks until it succeeds or fails.
          if [ -d "${keydir}" ]; then
            # Persistent machine-id record: bind it over
            # /etc/machine-id so post-mount consumers (and operators)
            # see the stable identity on disk. PID 1 already holds the
            # same value from the cmdline (systemd.machine_id=); this
            # is the on-disk consistency step. Done FIRST so no
            # key-related early exit below can skip it.
            mid="/persistent/etc/machine-id"
            if [ -s "$mid" ] && ! mountpoint -q /etc/machine-id; then
              [ -e /etc/machine-id ] || : > /etc/machine-id
              mount --bind "$mid" /etc/machine-id
              echo "nixos-persistent-keys: persistent machine-id presented"
            fi
        '' +
        # CLUSTER FEATURE ACTIVATION: the anchor shadows rootfs paths for
        # per-node state. NetworkManager connection profiles (the fabric
        # addresses -- static keyfiles, not DHCP) are bind-mounted over
        # the rootfs dir and NM reloaded so they apply without a boot.
        # Then the cluster feature target: its wants directory lives in
        # the ANCHOR (etc/systemd/system/ under the anchor, mirroring
        # the rootfs layout). /etc/systemd/system itself is a read-only
        # store symlink on NixOS, so the anchor's wants entries are
        # mirrored into /run/systemd/system/<target>.wants/ instead --
        # /run is a first-class unit search path (any .wants directory
        # there is honored) and writable with no mount tricks. The
        # mirror + daemon-reload + target start is what activates the
        # per-node units (local disk mounts, node services). Nothing
        # before this point reads the anchor's wants dir (it lives on
        # /persistent -- an earlier scan would trigger the automount
        # and block boot).
        ''
            nm_conf="/persistent/etc/NetworkManager/system-connections"
            if [ -d "$nm_conf" ]; then
              if ! mountpoint -q /etc/NetworkManager/system-connections; then
                mkdir -p /etc/NetworkManager/system-connections
                mount --bind "$nm_conf" /etc/NetworkManager/system-connections
              fi
              systemctl reload NetworkManager || true
              echo "nixos-persistent-keys: persistent NetworkManager profiles presented"
            fi
            anchor_wants="/persistent/etc/systemd/system/netboot-persistent.target.wants"
            run_wants="/run/systemd/system/netboot-persistent.target.wants"
            if [ -d "$anchor_wants" ]; then
              mkdir -p "$run_wants"
              for u in "$anchor_wants"/*; do
                ln -sfn "$u" "$run_wants/$(basename "$u")"
              done
              systemctl daemon-reload
              systemctl start netboot-persistent.target \
                || echo "nixos-persistent-keys: WARNING: netboot-persistent.target failed to start"
              echo "nixos-persistent-keys: cluster features activated"
            else
              echo "nixos-persistent-keys: no cluster wants dir in anchor (anchor created before profiles?)"
            fi
        '' + lib.concatMapStrings (keyPath:
          let name = baseNameOf keyPath; in ''
            if [ ! -s "${keydir}/${name}" ]; then
              echo "nixos-persistent-keys: ${keydir}/${name} missing; keeping baked key"
              exit 0
            fi
        '') bakedHostKeys + ''
            mkdir -p ${bakedKeysDir}
            mount --bind "${keydir}" ${bakedKeysDir}
            systemctl try-reload-or-restart sshd.service || true
            echo "nixos-persistent-keys: persistent host keys presented"
            exit 0
          fi
          echo "nixos-persistent-keys: /persistent not reachable yet (attempt $attempt/3); waiting"
          sleep 30
        done
        echo "nixos-persistent-keys: /persistent unreachable after retries; keeping baked key"
        exit 1
      '';
    };

  # The overlay worker's dispatch: fires 5s after boot, then re-fires
  # every 2 minutes until the flip sticks. The repeat matters: the
  # network can come up well past the first dispatch (a lease that
  # lands late makes mount attempts fail INSTANTLY with "network
  # unreachable", so the worker can burn all its attempts in under a
  # minute and give up), and without a re-dispatch nothing would ever
  # touch the mountpoint again. After a successful flip the unit stays
  # active (RemainAfterExit), so subsequent elapses are no-ops; after
  # a failed dispatch the next elapse starts it fresh. timers.target
  # jobs block nothing -- the login prompt is unaffected no matter how
  # long NFS takes.
  systemd.timers.nixos-persistent-keys = lib.mkIf (bakedHostKeys != [ ]) {
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnBootSec = "5s";
      OnUnitActiveSec = "2min";
      Unit = "nixos-persistent-keys.service";
    };
  };

  # ------------------------------------------------------------------
  # CLUSTER FEATURES (data-driven; see the let block at the top). All
  # of this is machinery -- every value comes from the private repo's
  # node data, nothing here is site-specific.
  # ------------------------------------------------------------------
  # (Shared NFS mounts and per-label disk mount units are rendered in
  # the merged systemd.mounts / systemd.automounts assignments above;
  # the activation point's anchor-side wants-dir symlink lives in the
  # merged environment.etc assignment.)

  # Directories that must exist on every node (most are the local-disk
  # mountpoints; mount units create their own, but an explicit rule
  # keeps the layout honest and covers non-mount dirs like /gluster).
  systemd.tmpfiles.rules = map (d: "d ${d} 0755 root root - -") mountDirs;

  # CLUSTER FEATURE TARGET: the per-node activation point. Its wants
  # directory lives in the ANCHOR (etc/systemd/system/ under the
  # anchor); the worker mirrors it into /run/systemd/system/ and
  # starts the target after the key flip. It is NOT part of the boot
  # chain: nothing wants it at boot, so the anchor-backed wants dir is
  # never scanned early (which would trigger the /persistent automount
  # and block boot).
  systemd.targets."netboot-persistent" = lib.mkIf (cluster != null) {
    description = "Per-node persistent-tree cluster features";
    wantedBy = [ ];
  };

  # LDAP users: nss/pam via nslcd (the daemon form; the house server
  # allows anonymous binds, so no bind credentials are declared).
  users.ldap = lib.mkIf (ldap != null) {
    enable = true;
    daemon.enable = true;
    server = ldap.server;
    base = ldap.base;
    # NSS/PAM resilience at boot (learned from blh3's first
    # cluster-image boot): nslcd starts before the network, and while
    # the LDAP server is unreachable each client request blocks for
    # the reconnect retry window (default reconnect_retrytime 10s).
    # Early-boot callers -- PID1's initgroups for every User= service,
    # logind's session setup, PAM logins -- each pay that cost per
    # lookup; logind blew its 90s notify deadline and hit its restart
    # limit, and NM sat 600s in nslcd's request queue behind a getty
    # autologin PAM storm. Two defenses:
    #   (a) fail fast: shrink the per-request reconnect window to ~1s
    #       (the lookups then return "no server" quickly and callers
    #       proceed; once the network is up the queries succeed);
    #   (b) start nslcd only after the network is genuinely usable.
    # Also note: initgroups CONSULTS the ldap module for EVERY user
    # (even files-hits like root) because the nsswitch group line is
    # "files ldap [success=merge]" -- there is no files short-circuit
    # for group-membership queries, so these knobs matter for all
    # services with a User=.
    daemon.extraConfig = ''
      # Fail fast when the LDAP server is unreachable (netboot boot
      # window); the defaults (sleep 1s, retry up to 10s per request)
      # made every early NSS/PAM lookup block for ~11 seconds.
      reconnect_sleeptime 1
      reconnect_retrytime 1
    '';
  };

  systemd.services.nslcd = lib.mkIf (ldap != null) {
    # See the nss-resilience comment above: serve lookups only once
    # the network is usable. Before nslcd runs, NSS ldap lookups fail
    # INSTANTLY (nothing listens on /run/nslcd/socket), which is the
    # desired early-boot behavior; a running nslcd is what makes them
    # block.
    wants = [ "network-online.target" ];
    after = [ "network-online.target" ];
  };

  # The installer profile auto-logins the default "nixos" user on
  # every console getty. On a fleet node that is wrong twice over:
  # with LDAP in the PAM stack each autologin fires pam_ldap at boot
  # (when the network is down) -- on blh3 that request storm was what
  # saturated nslcd and starved logind/NM of responses -- and it
  # hands out a wheel-member session with no password to anyone with
  # BMC console access.
  services.getty.autologinUser = lib.mkIf (cluster != null) (lib.mkForce null);

  # ------------------------------------------------------------------
  # SITE IMAGE HYGIENE: the netboot base is NixOS INSTALLER media, and
  # it ships installer/desktop conveniences a fleet node must not
  # have. Everything here is gated on cluster != null -- generic
  # (installer-like) builds keep stock behavior.
  # ------------------------------------------------------------------

  # No WiFi or cellular management: the NetworkManager module enables
  # wpa_supplicant (DBus-controlled) and ModemManager by default, for
  # wireless/WWAN adapters that rack servers do not have.
  # wpa_supplicant additionally cost an early-boot NSS lookup (PID1's
  # initgroups for its service user) during the boot-wedge incident.
  networking.wireless.enable =
    lib.mkIf (cluster != null) (lib.mkForce false);
  networking.modemmanager.enable =
    lib.mkIf (cluster != null) (lib.mkForce false);

  # The installer media sets wheelNeedsPassword=false with an
  # image-media override, rendering wheel sudo as NOPASSWD -- the
  # opposite of the house policy (the old gid-27 sudo group carried
  # Ubuntu's stock password-required rule). Force the standard
  # behavior back: sudo from wheel prompts for a password.
  security.sudo.wheelNeedsPassword =
    lib.mkIf (cluster != null) (lib.mkForce true);

  # The installer ships the full documentation set (NixOS manual, all
  # man pages) via image-media overrides; the fleet image does not
  # carry docs.
  documentation.enable = lib.mkIf (cluster != null) (lib.mkForce false);

  # The installer bundles the whole nixpkgs SOURCE TREE as a channel
  # (~485MB in the image) so the installer media can reinstall itself,
  # and ships the installer toolset (nixos-install / nixos-rebuild /
  # nixos-generate-config / nixos-option, dragging large python/perl
  # environments). Fleet nodes are redeployed as images and fixed
  # server-side via their anchors; they neither rebuild nor
  # reconfigure themselves. nix itself stays (nix-shell remains
  # available).
  system.installer.channel.enable =
    lib.mkIf (cluster != null) (lib.mkForce false);
  system.disableInstallerTools = lib.mkIf (cluster != null) true;

  # (Local admin accounts are merged into users.users up above, with
  # root's authorized keys.)

  # LDAP users needing sudo ride the local wheel group entry (see the
  # sudoUsers note in the let block).
  users.groups.wheel.members = lib.mkIf (sudoUsers != [ ]) sudoUsers;

  # Time: NTP source is the head node (the fleet has no outside NTP
  # route); mkForce replaces the module's default public pool -- a
  # netboot fleet must never leak ntp queries or depend on them. The
  # timesyncd primary AND fallback are both pinned (the fallback
  # option defaults to networking.timeServers, so forcing the primary
  # alone would leave a doubled list).
  time.timeZone = lib.mkIf (timeZone != null) timeZone;
  networking.timeServers =
    lib.mkIf (timeServers != null) (lib.mkForce timeServers);
  services.timesyncd = lib.mkIf (timeServers != null) {
    enable = true;
    servers = lib.mkForce timeServers;
    fallbackServers = lib.mkForce timeServers;
  };

  # Remote syslog: forward everything to the log server (UDP, the
  # house convention), keeping local logging. Uses the stock
  # services.rsyslogd module (full rsyslog). NOTE: the rsyslog-light
  # package is NOT viable -- it segfaults at startup on real hardware
  # (glibc 'Relink ... for IFUNC symbol modf' warning followed by
  # SIGSEGV in ld.so; reproduced on blh3 and in QEMU), so the full
  # package's optional-module closure (mongoc -> gcc, ~267MB on disk)
  # stays for now; it dies naturally under the Phase-3 store design.
  services.rsyslogd = lib.mkIf (logServer != null) {
    enable = true;
    extraConfig = ''
      # Everything to the log server.
      *.* @${logServer}
    '';
  };

  # mdadm software RAID: stage-1 assembly + the mdadm monitor, so the
  # by-label links for the disk mounts above exist by multi-user.
  boot.swraid.enable = lib.mkIf useSwraid true;
  boot.swraid.mdadmConf = lib.mkIf (useSwraid && mdadmConf != "") mdadmConf;

  # Fabric RDMA (100GbE Mellanox): the kernel drivers plus rdma-core
  # userspace (verbs, udev naming helpers).
  boot.kernelModules = lib.mkIf useRdma [ "mlx5_ib" "ib_uverbs" ];
  environment.systemPackages = lib.mkIf useRdma [ pkgs.rdma-core ];

  # Prometheus node exporter, oriented like the house install: the
  # ethtool collector on, the same filesystem exclusion regex (keeps
  # ephemeral/gluster mounts out of per-mount series), and the port
  # open should a node ever enable its firewall.
  services.prometheus.exporters.node = lib.mkIf useNodeExporter {
    enable = true;
    openFirewall = true;
    enabledCollectors = [ "ethtool" ];
    extraFlags = [
      "--collector.filesystem.mount-points-exclude=^/(dev|proc|run|sys|mnt|media|gluster|var/lib/docker/.+|var/lib/containers/storage/.+)($|/)"
    ];
  };
}
